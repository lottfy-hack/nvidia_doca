prefix=/opt/mellanox/doca
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: doca_urom_lib
Description: Internal-only DOCA pkg-config file. Not for direct use.
Use doca-urom instead of this file
Version: 2.7.0085
Libs: -Wl,--as-needed -L${prefix}/lib/aarch64-linux-gnu -ldoca_urom -ldoca_urom_components_comm_ucp_am -ldoca_urom_components_comm_ucp_rma
Libs.private: -lstdc++
Cflags: -I${includedir} -DALLOW_EXPERIMENTAL_API
