prefix=/opt/mellanox/doca
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: doca_flow_lib
Description: Internal-only DOCA pkg-config file. Not for direct use.
Use doca-flow instead of this file
Version: 2.7.0085
Libs: -Wl,--as-needed -L${prefix}/lib/aarch64-linux-gnu -ldoca_flow -ldoca_flow_ct -ldoca_flow_tune_server
Libs.private: -lstdc++
Cflags: -I${includedir} -DALLOW_EXPERIMENTAL_API
