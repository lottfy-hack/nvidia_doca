prefix=/opt/mellanox/doca
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: doca_pcc
Description: DOCA (doca-pcc) pkg-config file.
Version: 2.7.0085
Requires: doca-pcc-lib
Requires.private: libflexio, libibverbs, libmlx5, doca-common
Libs.private: -L${prefix}/lib/aarch64-linux-gnu -l:libdoca_pcc.a -Wl,--as-needed
Cflags: -I${includedir}
