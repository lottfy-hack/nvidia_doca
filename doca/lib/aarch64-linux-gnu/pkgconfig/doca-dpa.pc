prefix=/opt/mellanox/doca
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: doca_dpa
Description: DOCA (doca-dpa) pkg-config file.
Version: 2.7.0085
Requires: doca-dpa-lib
Requires.private: libflexio, libibverbs, libmlx5, doca-rdma, doca-comch, doca-common
Libs.private: -L${prefix}/lib/aarch64-linux-gnu -l:libdoca_dpa.a -Wl,--as-needed
Cflags: -I${includedir}
