prefix=/opt/mellanox/doca
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: doca
Description: DOCA (doca) pkg-config file.
Version: 2.7.0085
Requires: doca-lib
Requires.private: ucx, libflexio, libmlx5, libibverbs, libdpdk, glib-2.0, libcrypto, yara, libzip, libclx-api
Libs.private: -L${prefix}/lib/aarch64-linux-gnu -l:libdoca_urom_components_comm_ucp_rma.a -l:libdoca_urom_components_comm_ucp_am.a -l:libdoca_urom.a -l:libdoca_devemu_virtio_fs.a -l:libdoca_devemu_virtio_core.a -l:libdoca_devemu_pci.a -l:libdoca_pcc.a -l:libdoca_eth.a -l:libdoca_dpa.a -l:libdoca_rdma.a -l:libdoca_sha.a -l:libdoca_apsh.a -l:libdoca_comm_channel.a -l:libdoca_comch.a -l:libdoca_erasure_coding.a -l:libdoca_flow_tune_server.a -l:libdoca_flow_ct.a -l:libdoca_flow.a -l:libdoca_telemetry.a -l:libdoca_compress.a -l:libdoca_dma.a -l:libdoca_aes_gcm.a -l:libdoca_dpdk_bridge.a -l:libdoca_argp.a -l:libdoca_common.a -Wl,--as-needed -pthread -lm -ldl /opt/mellanox/dpdk/lib/aarch64-linux-gnu/libmlx5dr_dev.a /opt/mellanox/dpdk/lib/aarch64-linux-gnu/libmlx5dr_dev.a /opt/mellanox/dpdk/lib/aarch64-linux-gnu/libmlx5dr_dev.a
Cflags: -I${includedir}
